PREFIX dcterms: <http://purl.org/dc/terms/>
PREFIX prof: <http://www.w3.org/ns/dx/prof/>
PREFIX role: <http://www.w3.org/ns/dx/prof/role/>
PREFIX schema: <https://schema.org/>
PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>

<http://www.w3.org/ns/shacl/profile/positive>
    a prof:Profile ;
    prof:hasResource
        <http://www.w3.org/ns/shacl-shacl/positive> ,
        <http://www.w3.org/ns/shacl/profile/core/positive-elements-desc> ,
        <https://www.w3.org/TR/shacl12-profiling/#non-recursion-profile> ;
    prof:isProfileOf <http://www.w3.org/ns/shacl/profile/core> ;
    schema:description """A profile of SHACL 1.2 Core restricted to its positive fragment - excluding sh:not, sh:qualifiedMaxCount, sh:qualifiedValueShapesDisjoint, and sh:xone. Excluding these constraint properties from a shapes graph ensures recursively-defined shapes always resolve to a definite conforms-or-violates outcome, computed by a well-defined, tractable semantics.

Vocabulary elements of SHACL that are not listed as members of this profile may not be used for implementations claiming conformance to this profile.
"""@en ;
    schema:name "SHACL 1.2 Positive Profile" ;
.

<http://www.w3.org/ns/shacl-shacl/positive>
    a prof:ResourceDescriptor ;
    dcterms:conformsTo <https://www.w3.org/TR/shacl/> ;
    dcterms:format "text/turtle" ;
    prof:hasArtifact <http://www.w3.org/ns/shacl-shacl/positive> ;
    prof:hasRole role:Validation ;
.

<https://www.w3.org/TR/shacl12-profiling/#non-recursion-profile>
    a prof:ResourceDescriptor ;
    dcterms:conformsTo <http://www.w3.org/TR/html5/> ;
    dcterms:format "text/html" ;
    prof:hasArtifact <https://www.w3.org/TR/shacl12-profiling/#non-recursion-profile> ;
    prof:hasRole role:Specification ;
.

<http://www.w3.org/ns/shacl/profile/core/positive-elements-desc>
  a prof:ResourceDescriptor ;
  prof:hasRole role:vocabulary ;
  prof:hasArtifact <http://www.w3.org/ns/shacl/profile/core/positive-elements> ;
.

<http://www.w3.org/ns/shacl/profile/core/positive-elements>
    a rdf:Bag;
    rdfs:label "Non-Recursive SHACL elements" ;
    rdfs:comment "Elements of SHACL 1.2 Core that do not cause recursion when used for validation.  rdfs:seeAlso lists elements excluded from membership within this Bag." ;
    rdfs:seeAlso
        sh:not ,
        sh:qualifiedMaxCount ,
        sh:qualifiedValueShapesDisjoint ,
        sh:xone ;
    rdfs:member
        sh:AbstractResult ,
        sh:AndConstraintComponent ,

        # ... many skipped members

        sh:xone ,
        sh:zeroOrMorePath ,
        sh:zeroOrOnePath ;
.
